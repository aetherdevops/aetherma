APP_NAME="Æther Marketing Agency"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# First admin account (used by `php artisan db:seed`). Leave the password
# empty to have a random one generated and printed once.
ADMIN_NAME="Aether Admin"
ADMIN_EMAIL=admin@aether.local
ADMIN_PASSWORD=

# Where contact form submissions are emailed (comma separated). Needs a real
# MAIL_MAILER (e.g. smtp) — with MAIL_MAILER=log they only go to the log file.
CONTACT_NOTIFY_EMAIL=

# Public contact details and social profiles (config/site.php). Anything left
# empty is simply not shown on the site. Quote values that contain spaces,
# e.g. SITE_PHONE="+1 555 010 0000".
SITE_EMAIL=
SITE_PHONE=
SITE_LOCATION=
SITE_MAP_URL=
SITE_BOOKING_URL=
SOCIAL_INSTAGRAM=
SOCIAL_LINKEDIN=
SOCIAL_FACEBOOK=
SOCIAL_TIKTOK=
SOCIAL_BEHANCE=

# Analytics (production only). Plausible is cookieless; GA4 loads only after
# the visitor accepts the cookie banner, which appears automatically when set.
ANALYTICS_PLAUSIBLE_DOMAIN=
ANALYTICS_GA4_ID=

# Date shown on /privacy as "last updated" (YYYY-MM-DD).
SITE_PRIVACY_UPDATED=2026-09-25

VITE_APP_NAME="${APP_NAME}"
