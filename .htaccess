# For hosts where the project root is the web root (e.g. cloned straight into
# public_html). Every request is served from public/ internally, so the site
# works on the bare domain and .env, vendor/, storage/ etc. are never reachable.
# Pointing the document root at public/ directly makes this file unused.

DirectoryIndex index.php
Options -Indexes

# Never serve dotfiles (.env, .git, .htaccess ...), even without mod_rewrite.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Deny well-known sensitive files by name as a fallback without mod_rewrite.
<FilesMatch "^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|tailwind\.config\.js|postcss\.config\.js|README\.md)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^public(/|$) - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
